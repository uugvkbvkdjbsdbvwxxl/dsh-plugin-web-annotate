{
  "name": "@wxlaz/dsh-plugin-web-annotate",
  "version": "1.0.0",
  "description": "Annotate elements on a page in the built-in browser and send the comments to the session in one click.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "annotations",
    "ui"
  ],
  "homepage": "https://github.com/uugvkbvkdjbsdbvwxxl/dsh-plugin-web-annotate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uugvkbvkdjbsdbvwxxl/dsh-plugin-web-annotate.git"
  },
  "bugs": {
    "url": "https://github.com/uugvkbvkdjbsdbvwxxl/dsh-plugin-web-annotate/issues"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
